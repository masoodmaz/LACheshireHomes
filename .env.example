# Server
PORT=5000
SESSION_SECRET=change-this-to-a-long-random-string

# Set to "production" when deployed. Enables the Secure cookie flag over HTTPS
# and turns on proxy trust by default.
# NODE_ENV=production

# Reverse-proxy trust. Leave unset for local dev. Behind nginx/Caddy/a PaaS,
# this lets the app see the real HTTPS scheme + host via X-Forwarded-* headers.
# Values: "true", "false", a hop count like "1", or an IP/subnet string.
# Defaults to 1 when NODE_ENV=production, false otherwise.
# TRUST_PROXY=1

# Site
SITE_NAME=LA Cheshire Homes
# Public base URL. Set this explicitly in production (e.g. https://yourdomain.com)
# — it defines the OAuth callback ({SITE_URL}/auth/google/callback) and must
# match an Authorized redirect URI in the Google Cloud Console.
SITE_URL=http://localhost:5000

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI must be: {SITE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of Google account emails allowed to sign in as admin
ADMIN_EMAILS=you@example.com

# WhatsApp click-to-chat button. International format, digits only (no +, spaces
# or dashes). Leave WHATSAPP_NUMBER blank to hide the floating button.
WHATSAPP_NUMBER=447722087227
WHATSAPP_MESSAGE=Hi, I'm interested in one of your properties.
