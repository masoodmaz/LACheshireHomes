#!/bin/bash
# cloud-init bootstrap for the LA Cheshire Homes Lightsail instance.
# Installs Docker + Compose, mounts the persistent data disk, and (optionally)
# deploys the app from a git repo.
#
# NOTE: Lightsail's cloud-init may run this under dash (/bin/sh), so keep it
# POSIX-compatible — no `pipefail` or other bashisms.
set -eux

APP_DIR="/opt/${instance_name}"
MOUNT_POINT="/opt/${instance_name}"

#############################################
# 1. Install Docker Engine + Compose plugin
#############################################
export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y ca-certificates curl git
curl -fsSL https://get.docker.com | sh   # installs docker + compose plugin
systemctl enable --now docker
usermod -aG docker ubuntu || true

#############################################
# 2. Find, format (once) and mount the disk
#############################################
# Lightsail attaches the disk at /dev/xvdf, but Nitro hosts may expose it as
# an nvme device. The attachment completes ~60s AFTER the instance boots, so
# poll for the device (up to ~5 min) instead of checking once.
DEVICE=""
for _ in $(seq 1 60); do
  for candidate in /dev/xvdf /dev/nvme1n1; do
    if [ -b "$candidate" ]; then DEVICE="$candidate"; break; fi
  done
  [ -n "$DEVICE" ] && break
  sleep 5
done

if [ -n "$DEVICE" ]; then
  # Format only if the disk has no filesystem yet (so redeploys keep data).
  if ! blkid "$DEVICE"; then
    mkfs.ext4 -F "$DEVICE"
  fi
  mkdir -p "$MOUNT_POINT"
  UUID="$(blkid -s UUID -o value "$DEVICE")"
  if ! grep -q "$UUID" /etc/fstab; then
    echo "UUID=$UUID $MOUNT_POINT ext4 defaults,nofail 0 2" >> /etc/fstab
  fi
  mount -a
fi

mkdir -p "$APP_DIR"

#############################################
# 3. Optional: clone repo + start the app
#############################################
REPO_URL="${repo_url}"
if [ -n "$REPO_URL" ]; then
  # The disk mount point contains lost+found, so clone into a temp dir and copy
  # in (git clone refuses a non-empty target).
  if [ ! -d "$APP_DIR/.git" ]; then
    TMP="$(mktemp -d)"
    git clone "$REPO_URL" "$TMP"
    cp -a "$TMP/." "$APP_DIR/"
    rm -rf "$TMP"
  else
    git -C "$APP_DIR" pull --ff-only || true
  fi

  cd "$APP_DIR"

  # .env is gitignored, so seed one from the example if it's missing.
  # EDIT THIS on the server with real secrets before going live.
  if [ ! -f .env ] && [ -f .env.example ]; then
    cp .env.example .env
  fi

  # Reverse proxy (Caddy) terminates self-signed TLS on 80/443 and proxies to
  # the app over the internal Docker network. No domain yet, so Caddy's internal
  # CA issues a cert for the IP; default_sni lets it serve that cert when clients
  # connect to the bare IP (which sends no TLS SNI).
  cat > Caddyfile <<'CADDY'
{
	default_sni ${public_ip}
}

${public_ip} {
	tls internal
	reverse_proxy app:5000
}
CADDY

  cat > docker-compose.override.yml <<'YAML'
services:
  caddy:
    image: caddy:2-alpine
    container_name: ${instance_name}-caddy
    restart: unless-stopped
    depends_on:
      - app
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config

volumes:
  caddy_data:
  caddy_config:
YAML

  # Build first so we can read the container's uid/gid, then create the
  # bind-mount targets owned by that user. The app runs as non-root, so the
  # host-side ./data and ./public/uploads dirs must be writable by it or SQLite
  # fails with "unable to open database file".
  docker compose build
  mkdir -p data public/uploads/images public/uploads/videos
  APPUID="$(docker compose run --rm app id -u 2>/dev/null | tr -d '[:space:]')"
  APPGID="$(docker compose run --rm app id -g 2>/dev/null | tr -d '[:space:]')"
  [ -n "$APPUID" ] || APPUID=100
  [ -n "$APPGID" ] || APPGID=101
  chown -R "$APPUID:$APPGID" data public/uploads

  docker compose up -d
fi
