<section class="container section narrow">
  <p class="eyebrow">Contact</p>
  <h1>Talk to us</h1>
  <p class="lede">Interested in one of our developments or want to discuss a project? Send us a message and our
    team will get back to you.</p>

  <% if (sent) { %>
    <p class="notice success">Thank you &mdash; your enquiry has been sent. We'll be in touch soon.</p>
  <% } %>
  <% if (error) { %>
    <p class="notice"><%= error %></p>
  <% } %>

  <form class="contact-form" method="post" action="/contact">
    <label>Name
      <input type="text" name="name" autocomplete="name" maxlength="120" required value="<%= form.name || '' %>">
    </label>
    <label>Email
      <input type="email" name="email" autocomplete="email" maxlength="200" required value="<%= form.email || '' %>">
    </label>
    <label>Phone (optional)
      <input type="tel" name="phone" autocomplete="tel" maxlength="40" value="<%= form.phone || '' %>">
    </label>
    <label>Message
      <textarea name="message" rows="6" maxlength="5000" required><%= form.message || '' %></textarea>
    </label>
    <!-- Honeypot: hidden from humans, bots tend to fill it -->
    <label class="hp-field" aria-hidden="true">Company
      <input type="text" name="company" tabindex="-1" autocomplete="off">
    </label>
    <button class="button primary" type="submit">Send enquiry</button>
    <p class="subtle">We'll only use your details to respond to your enquiry.</p>
  </form>
</section>
