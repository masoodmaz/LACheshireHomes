<section class="container section">
  <%- include("_admin-nav") %>
  <div class="section-heading">
    <h1>Projects</h1>
    <a class="button primary" href="/admin/projects/new">+ New project</a>
  </div>

  <% if (!projects.length) { %>
    <p class="subtle">No projects yet. Create your first one.</p>
  <% } else { %>
    <table class="admin-table">
      <thead>
        <tr><th>Cover</th><th>Title</th><th>Status</th><th>Published</th><th>Updated</th><th></th></tr>
      </thead>
      <tbody>
        <% projects.forEach(project => { %>
          <tr>
            <td>
              <% if (project.thumbnail) { %>
                <img class="table-thumb" src="<%= project.thumbnail %>" alt="" loading="lazy">
              <% } else { %>
                <span class="table-thumb placeholder"></span>
              <% } %>
            </td>
            <td><%= project.title %></td>
            <td><span class="badge status-<%= project.status %>"><%= project.status %></span></td>
            <td><%= project.published ? "Yes" : "No" %></td>
            <td><%= new Date(project.updated_at).toLocaleDateString() %></td>
            <td class="table-actions">
              <a href="/admin/projects/<%= project.id %>/edit">Edit</a>
              <a href="/projects/<%= project.slug %>" target="_blank" rel="noopener noreferrer">View</a>
              <form method="post" action="/admin/projects/<%= project.id %>/delete" onsubmit="return confirm('Delete this project and all its media?');">
                <button class="link-button danger" type="submit">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>
